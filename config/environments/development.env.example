# APEX ONE — Development Profile (Arena & Local Docker-free Dev)
APEX_ENV=development
APEX_DEBUG=true
APEX_LOG_LEVEL=DEBUG
APEX_HOST=0.0.0.0
APEX_PORT=8000

# PostgreSQL (Neon / external dev branch; optional during offline UI/unit work)
APEX_DB_POOL_MODE=nullpool
APEX_DB_SSL_REQUIRED=false
APEX_DB_ECHO_SQL=false
# APEX_DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/apex_one_dev

# Optional Redis
APEX_REDIS_REQUIRED=false
# APEX_REDIS_URL=redis://127.0.0.1:6379/0

# Worker & Outbox
APEX_WORKER_POLL_INTERVAL_SECONDS=2.0
APEX_WORKER_LEASE_SECONDS=60
APEX_WORKER_HEARTBEAT_SECONDS=15
APEX_WORKER_MAX_ATTEMPTS=5

# Sandbox & Hybrid Local Node
APEX_SANDBOX_PROVIDER=none
APEX_SANDBOX_ISOLATION_ATTESTED=false
APEX_ARENA_ISOLATED_MODE=true
