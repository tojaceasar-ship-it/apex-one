# APEX ONE — Production Profile
APEX_ENV=production
APEX_DEBUG=false
APEX_LOG_LEVEL=INFO
APEX_HOST=0.0.0.0
APEX_PORT=8000

# Mandatory Secret Key (32+ random bytes from KMS / Secret Manager)
APEX_SECRET_KEY=REPLACE_FROM_SECRET_MANAGER_MIN_32_CHARS

# Primary Production PostgreSQL 16+ (RLS + TLS mandatory; SQLite/JSON strictly forbidden)
APEX_DB_POOL_MODE=pooled
APEX_DB_POOL_SIZE=20
APEX_DB_MAX_OVERFLOW=20
APEX_DB_SSL_REQUIRED=true
APEX_DATABASE_URL=postgresql+asyncpg://apex_app:REPLACE_FROM_SECRET_MANAGER@prod-db.example.internal:5432/apex_one_prod

# Optional Redis Acceleration Layer
APEX_REDIS_REQUIRED=false
APEX_REDIS_URL=rediss://default:REPLACE_FROM_SECRET_MANAGER@prod-redis.example.internal:6379/0

# Worker & Outbox
APEX_WORKER_POLL_INTERVAL_SECONDS=0.5
APEX_WORKER_LEASE_SECONDS=120
APEX_WORKER_HEARTBEAT_SECONDS=20
APEX_WORKER_MAX_ATTEMPTS=8

# Mandatory Verified MicroVM Experiment Sandbox Provider
APEX_SANDBOX_PROVIDER=external_http
APEX_SANDBOX_ISOLATION_ATTESTED=true
APEX_SANDBOX_ENDPOINT=https://prod-sandbox.example.internal
APEX_SANDBOX_API_KEY=REPLACE_FROM_SECRET_MANAGER

# Hybrid Local Node Gateway
APEX_ARENA_ISOLATED_MODE=false
APEX_LOCAL_NODE_SHARED_SECRET=REPLACE_FROM_SECRET_MANAGER_MIN_32_CHARS
APEX_ALLOWED_ORIGINS=https://app.apex-one.example.com
