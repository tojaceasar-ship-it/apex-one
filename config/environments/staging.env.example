# APEX ONE — Staging Profile
APEX_ENV=staging
APEX_DEBUG=false
APEX_LOG_LEVEL=INFO
APEX_HOST=0.0.0.0
APEX_PORT=8000

# Mandatory Secret Key (32+ random bytes)
APEX_SECRET_KEY=REPLACE_WITH_STAGING_SECRET_MIN_32_CHARS

# PostgreSQL (Managed PostgreSQL 16+ with pgvector & RLS enforced)
APEX_DB_POOL_MODE=pooled
APEX_DB_POOL_SIZE=10
APEX_DB_MAX_OVERFLOW=10
APEX_DB_SSL_REQUIRED=true
APEX_DATABASE_URL=postgresql+asyncpg://apex_app:REPLACE_ME@staging-db.example.internal:5432/apex_one_staging

# Optional Redis
APEX_REDIS_REQUIRED=false
# APEX_REDIS_URL=rediss://default:REPLACE_ME@staging-redis.example.internal:6379/0

# Worker & Outbox
APEX_WORKER_POLL_INTERVAL_SECONDS=1.0
APEX_WORKER_LEASE_SECONDS=90
APEX_WORKER_HEARTBEAT_SECONDS=20
APEX_WORKER_MAX_ATTEMPTS=6

# Verified External Sandbox Provider
APEX_SANDBOX_PROVIDER=external_http
APEX_SANDBOX_ISOLATION_ATTESTED=true
APEX_SANDBOX_ENDPOINT=https://staging-sandbox.example.internal
APEX_SANDBOX_API_KEY=REPLACE_ME

# Hybrid Local Node Gateway
APEX_ARENA_ISOLATED_MODE=false
APEX_LOCAL_NODE_SHARED_SECRET=REPLACE_WITH_STAGING_HMAC_SECRET_MIN_32_CHARS
APEX_ALLOWED_ORIGINS=https://staging.apex-one.example.com
