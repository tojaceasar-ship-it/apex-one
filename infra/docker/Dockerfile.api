FROM python:3.11-slim

RUN groupadd --gid 10001 apex \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin apex

WORKDIR /app
COPY requirements.txt pyproject.toml alembic.ini ./
RUN pip install --no-cache-dir -r requirements.txt

COPY --chown=10001:10001 backend ./backend
COPY --chown=10001:10001 migrations ./migrations
COPY --chown=10001:10001 agents ./agents
COPY --chown=10001:10001 datasets ./datasets

ENV PYTHONPATH=/app/backend \
    APEX_RUN_MIGRATIONS_ON_START=false

USER 10001:10001
EXPOSE 8000
CMD ["sh", "-c", "if [ \"$APEX_RUN_MIGRATIONS_ON_START\" = \"true\" ]; then alembic upgrade head; fi && exec uvicorn apex_one.api.main:app --host 0.0.0.0 --port 8000"]
