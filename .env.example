# APEX ONE Research Edition — Example Root Configuration
# Copy to .env (never committed) and supply external service credentials when ready.

APEX_ENV=development
APEX_HOST=0.0.0.0
APEX_PORT=8000

# External PostgreSQL 16+ with pgvector (e.g., Neon, Supabase, RDS)
# Leave unset in Arena until an external database is authorized.
# APEX_DATABASE_URL=postgresql+asyncpg://apex_app:CHANGE_ME@ep-example.eu-central-1.aws.neon.tech/apex_one?ssl=require

# Optional Redis adapter (cache & pub/sub acceleration; persistence uses PostgreSQL Outbox)
# APEX_REDIS_URL=rediss://default:CHANGE_ME@example-redis.upstash.io:6379

# Experiment Sandbox Provider (keep "none" until external isolated microVM provider is configured)
APEX_SANDBOX_PROVIDER=none
APEX_SANDBOX_ISOLATION_ATTESTED=false
# APEX_SANDBOX_ENDPOINT=https://sandbox-gateway.example.internal
# APEX_SANDBOX_API_KEY=CHANGE_ME

# Hybrid Local Node Gateway
APEX_ARENA_ISOLATED_MODE=true
# APEX_LOCAL_NODE_SHARED_SECRET=CHANGE_ME_AT_LEAST_32_CHARS
